# Copy to .env.local and fill in. .env.local is gitignored.
#
# Both values are public by design: they ship in the JavaScript bundle and anyone with
# the app can read them. They are identifiers, not secrets. What an anon key may
# actually do is decided entirely by RLS policies in the database — see docs/SECURITY.md.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. NEVER prefix a service-role key with VITE_ — that would bundle a key
# that bypasses every RLS policy into a file served to the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# Used by `npm run db:test` to apply migrations to a throwaway local Postgres.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
